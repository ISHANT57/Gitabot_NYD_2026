# Hindu Texts Q&A Chatbot Environment Variables
# Copy this file to .env and fill in your API keys

# Mistral API Key (required for embeddings / semantic search)
# Get from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Gemini API Key (primary answer generation)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (optional fallback for answer generation)
# Get from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vector Database (optional, uses FAISS if not available)
QDRANT_URL=http://localhost:6333

